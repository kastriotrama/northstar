ENVIRONMENT=local
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Per-datastore timeout (seconds) for the /health endpoint checks
HEALTH_CHECK_TIMEOUT_SECONDS=2

# PostgreSQL
# - POSTGRES_DB / POSTGRES_USER / POSTGRES_PASSWORD are read by docker-compose
#   to initialize the container.
# - POSTGRES_HOST_PORT is the port published on your machine; change it if
#   another local project already uses 5432, and keep DATABASE_URL in sync.
# - The API only reads DATABASE_URL.
POSTGRES_HOST_PORT=5432
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me
DATABASE_URL=postgresql://app:change_me@localhost:5432/app
RESOLVED_MATCH_SHOWCASE_PATH=outputs/ts-ktype-resolved-showcase-1000.json
# Read-only VD-AI PostgreSQL source used by `northstar-ingest import-remote-passenger`.
REMOTE_DATABASE_URL=

# Neo4j
NEO4J_HTTP_HOST_PORT=7474
NEO4J_BOLT_HOST_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# Elasticsearch
ELASTICSEARCH_HOST_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200
ES_JAVA_OPTS=-Xms512m -Xmx512m

# Redis
REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379/0

INGESTION_BATCH_SIZE=500
TECDOC_SOURCE_PATH=
TECDOC_SOURCE_VERSION=
TECDOC_FORMAT_VERSION=
TECDOC_LICENSE_REFERENCE=
TECDOC_SOURCE_CHECKSUM=
TECDOC_SOURCE_SCHEMA=tecdoc_source
TRANSPORTSTYRELSEN_SOURCE_PATH=

OPENAI_API_KEY=

GITHUB_PAT_TOKEN=

ATLASSIAN_SITE_URL=
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
ATLASSIAN_MCP_AUTHORIZATION=

# OEM VIN data provider (paid; leave empty until contract is confirmed)
OEM_VIN_PROVIDER_NAME=
OEM_VIN_PROVIDER_BASE_URL=
OEM_VIN_PROVIDER_API_KEY=
OEM_VIN_PROVIDER_DATASET_VERSION=unversioned
OEM_VIN_PROVIDER_TIMEOUT_SECONDS=15

# Rule advisor (AI Suggest Rule). With no key the deterministic
# PatternRuleAdvisor is used; setting OPENAI_API_KEY activates the LLM adapter,
# which falls back to the deterministic advisor on any failure.
RULE_ADVISOR_MODEL=gpt-4o-mini
RULE_ADVISOR_BASE_URL=https://api.openai.com/v1
RULE_ADVISOR_TIMEOUT_SECONDS=30
