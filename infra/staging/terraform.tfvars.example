project_name = "northstar"
environment  = "staging"
region       = "eu-north-1"

network = {
  vpc_id              = "vpc-placeholder"
  private_subnet_ids  = ["subnet-placeholder-a", "subnet-placeholder-b"]
  allowed_cidr_blocks = ["10.0.0.0/16"]
}

postgres = {
  instance_class       = "db.t4g.micro"
  allocated_storage_gb = 20
  database_name        = "app"
  username_secret_name = "northstar/staging/postgres/username"
  password_secret_name = "northstar/staging/postgres/password"
}

neo4j = {
  instance_type        = "t4g.small"
  volume_size_gb       = 30
  username_secret_name = "northstar/staging/neo4j/username"
  password_secret_name = "northstar/staging/neo4j/password"
}

elasticsearch = {
  instance_type  = "t3.small.search"
  instance_count = 1
  volume_size_gb = 20
}

redis = {
  node_type        = "cache.t4g.micro"
  replica_count    = 0
  auth_secret_name = "northstar/staging/redis/auth"
}
